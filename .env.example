# Copy to .env and fill in. Never commit the real .env.

# Anthropic API key used by the n8n Anthropic Chat Model credential
# and by the test runner's LLM-as-judge / simulated-conversation modes.
ANTHROPIC_API_KEY=

# n8n API key (created in the n8n UI: Settings > API), used by n8n-as-code
# (n8nac) to pull/push workflows and by scripts/export.sh.
N8N_API_KEY=

# Shared secret required as a header on the test-harness webhook so it
# can't be triggered by arbitrary requests.
TEST_WEBHOOK_SECRET=
