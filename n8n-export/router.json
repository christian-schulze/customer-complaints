    {
      "id": "54a1ba24-8483-403a-8c35-33428cb8290c",
      "name": "Determine Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst result = item.result || {};\nconst label = result.label;\nconst escalate = result.escalate === true;\n\n// FR-7.1: deterministic routing on label + escalate, not model judgment.\nlet routeIndex;\nif (label === 'legitimate' && !escalate) routeIndex = 0;\nelse if (label === 'legitimate' && escalate) routeIndex = 1;\nelse if (label === 'unknown') routeIndex = 2;\nelse if (label === 'not_legitimate' && escalate) routeIndex = 2;\nelse routeIndex = 3; // not_legitimate, not escalated\n\nreturn [{ json: { ...item, routeIndex } }];"
      }
    },
    {
